# Maharga Motor - Supabase Cloud Configuration
# Salin file ini menjadi .env dan sesuaikan dengan kredensial project Supabase Anda.

# Project URL dari Supabase Dashboard
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Anon Public Key / Publishable Key (Aman di frontend)
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here
