# ==============================================================================
# Maharga Motor - Security Regression Check Configuration
# Salin berkas ini ke `.env.security-check` dan sesuaikan dengan environment Anda:
#   cp .env.security-check.example .env.security-check
# ==============================================================================

# 1. Supabase Project URL (Contoh: https://ouuxgwskivkugrndgsiv.supabase.co)
SUPABASE_URL=https://ouuxgwskivkugrndgsiv.supabase.co

# 2. Supabase Anon/Publishable Key (Kunci publik aman untuk test read-only anon)
SUPABASE_ANON_KEY=sb_publishable_63sqg2cApl4sPTHttI299g_mdkynvk8

# 3. Domain Web App (Domain publik tanpa http/https, contoh: maharga.com atau your-app.pages.dev)
APP_DOMAIN=maharga-motor.pages.dev
