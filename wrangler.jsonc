{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maharga-motor",
  "main": "worker.js",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  },
  "vars": {
    "SUPABASE_URL": "https://ouuxgwskivkugrndgsiv.supabase.co"
  }
}
